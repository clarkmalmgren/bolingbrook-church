{
  "name": "bolingbrook-church",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "start:local": "NEXT_PUBLIC_SIM=true && next dev",
    "start:beta": "next dev",
    "start:prod": "next start",
    "build:local": "NODE_ENV=development && NEXT_PUBLIC_SIM=true && next build",
    "build:beta": "NODE_ENV=development && next build",
    "build:prod": "next build",
    "deploy:beta": "firebase use bolingbrook-church-beta && env-cmd -f .env.beta firebase deploy --only hosting",
    "deploy:prod": "firebase use bolingbrook-church && firebase deploy --only hosting",
    "emulators": "firebase use bolingbrook-church-beta && firebase emulators:start --import=.firebase_data --export-on-exit .firebase_data",
    "lint": "next lint"
  },
  "dependencies": {
    "@editorjs/editorjs": "^2.29.0",
    "@editorjs/header": "^2.8.1",
    "@editorjs/paragraph": "^2.11.3",
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource/metropolis": "^5.0.7",
    "@mui/icons-material": "^5.15.12",
    "@mui/material": "^5.15.9",
    "@mui/material-nextjs": "^5.15.9",
    "@react-hookz/deep-equal": "^2.0.2",
    "firebase": "^10.8.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "next": "14.1.0",
    "react": "^18",
    "react-dom": "^18",
    "react-mui-fileuploader": "^0.4.1",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "env-cmd": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "postcss": "^8",
    "typescript": "^5"
  },
  "overrides": {
    "string-width": "^4",
    "strip-ansi": "^6"
  },
  "resolutions": {
    "string-width": "^4",
    "strip-ansi": "^6"
  }
}
